{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gear-guru-guide",
  "main": "./server/worker.ts",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/owner-dashboard*"
    ]
  }
}
